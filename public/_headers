# Cache policy for Cloudflare Pages (Netlify reads the same format, so
# this survives a change of host).
#
# No redirect rules are needed anywhere: the app uses createHashRouter,
# so every route lives after the # and the server only ever serves /.

# The default. HTML is the one file whose contents change at a URL that
# stays the same, so it must be revalidated — a cached index.html points
# visitors at the previous build's asset filenames.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Listed second on purpose: both hosts let a later, more specific rule
# win. Vite content-hashes everything under /assets, so a given filename
# can never change meaning and is safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
